# 오프라인(로컬) 모드 스위치 — docker compose의 DB(localhost:55433) + 외부 호출 금지
# 전환: cp backend/.env.local backend/.env
# 복귀: 팀 비밀 저장소의 Session pooler URI로 backend/.env 원복
# (비밀값 없음 — 로컬 도커 전용 계정이라 커밋 허용)
DATABASE_URL=postgresql://postgres:postgres@localhost:55433/postgres
CACHE_ONLY=1
CORS_ORIGINS=http://localhost:5173
# DEMO_NOW=2026-08-02T14:00
